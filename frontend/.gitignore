# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# T072's walk against the deployed environment writes screenshots and a results file here.
# They are evidence for one run, not source — and a Playwright storageState written beside them
# would be a live production session cookie inside the checkout.
scripts/t072-shots/

# T044's local hand-walk, same reasoning.
scripts/t044-shots/

# Generated on every dev/build by scripts/copy-maplibre-worker.mjs — MapLibre's worker plus the
# shared chunk it imports, copied under their original (unhashed) names so the worker's own
# relative import resolves. Regenerated rather than committed so it cannot drift from the
# installed maplibre-gl version.
public/maplibre/
