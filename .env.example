# Victor Tracker — every variable either app reads. Copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored. Real credentials never enter the repository; production values are set in the
# Render and Vercel dashboards, not here.

# ---------------------------------------------------------------------------
# Postgres (docker-compose service `db`)
# ---------------------------------------------------------------------------
POSTGRES_USER=creatorhub
POSTGRES_PASSWORD=creatorhub
POSTGRES_DB=creatorhub
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Backend — FastAPI (backend/app/config.py)
# ---------------------------------------------------------------------------

# SQLAlchemy URL. Inside compose the host is `db`; from the host shell it is localhost, which is what
# running Alembic or pytest outside the container needs:
#   postgresql+psycopg://creatorhub:creatorhub@localhost:5432/creatorhub
DATABASE_URL=postgresql+psycopg://creatorhub:creatorhub@localhost:5432/creatorhub

# Dedicated test database. Created by scripts/init-test-db.sql on first `docker compose up`. pytest
# must never point at DATABASE_URL; the harness truncates this one between tests.
TEST_DATABASE_URL=postgresql+psycopg://creatorhub:creatorhub@localhost:5432/creatorhub_test

# Signs the session JWT. No default anywhere in the code — an app that boots with a guessable secret
# is worse than one that refuses to boot. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# FR-002a: a session lasts ~30 days and slides on use. Changing this changes how long a leaked token
# stays valid — there is no denylist at v0.1.
TOKEN_TTL_DAYS=30

# CORS allowlist. Defence in depth only: the Next.js proxy allowlist is the real boundary, since no
# browser ever contacts the backend origin directly.
FRONTEND_ORIGIN=http://localhost:3000

BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# The single account (backend/app/scripts/seed_user.py)
# ---------------------------------------------------------------------------
# There is no registration endpoint. This script is the only thing that creates a creator.
SEED_CREATOR_EMAIL=
SEED_CREATOR_PASSWORD=

# ---------------------------------------------------------------------------
# Frontend — Next.js (the proxy, the login page)
# ---------------------------------------------------------------------------

# Where the proxy forwards to, server-side. Not NEXT_PUBLIC_ on purpose: the backend origin stays
# invisible to the browser. In production this is the Render URL.
API_BASE_URL=http://localhost:8000

# The httpOnly session cookie holding the JWT.
SESSION_COOKIE_NAME=ch_session

# Must be true in production. False locally because a Secure cookie is not stored over plain http.
SESSION_COOKIE_SECURE=false

FRONTEND_PORT=3000

# Object storage (Cloudflare R2) — Trip/Destination photographs. Presigned PUT/GET only; the bucket
# is never public. Leave blank locally and photograph upload fails with a message naming these four
# variables instead of an opaque endpoint error.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ---------------------------------------------------------------------------
# Travel Intelligence (the AI module) — backend/app/ai/
# ---------------------------------------------------------------------------
# Provider-neutral: app/ai/client.py speaks the OpenAI chat-completions shape, which many providers
# implement (Hugging Face's router, Groq, OpenRouter, a local llama.cpp or Ollama server). Switching
# providers is meant to be editing these three lines, not a code change.
#
# An empty AI_BASE_URL or AI_MODEL falls back to its default rather than booting with an empty
# value (config.py's `_blank_means_unset`) — AI_API_KEY does not get that fallback, since for a
# credential blank genuinely means unset, and that is exactly what the AI module should refuse on.

# Full chat-completions endpoint URL. Must be OpenAI-compatible — it receives
# {model, messages, max_tokens, temperature} and must answer with `choices[0].message`.
# Examples: https://router.huggingface.co/v1/chat/completions (default), https://api.groq.com/openai/v1/chat/completions
AI_BASE_URL=

# Bearer token for the provider above. Empty means the AI console answers with a message naming this
# variable rather than failing obscurely.
AI_API_KEY=

# Model id sent to the provider above. Must be one that provider actually serves, and preferably one
# without a forced reasoning mode you cannot turn off (see app/ai/client.py's own notes on this).
# Example for Groq: openai/gpt-oss-120b
AI_MODEL=

# Legacy spellings, still accepted (AliasChoices in config.py) so an existing .env keeps working —
# prefer the AI_* names above for anything new. HF_TOKEN maps to AI_API_KEY, HF_MODEL to AI_MODEL,
# HF_ROUTER_URL to AI_BASE_URL.
HF_TOKEN=
HF_MODEL=
